# Backend
DATABASE_URL=postgresql://ingestion:ingestion@postgres:5432/ingestion
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/app/storage
FILE_MANAGER_QUEUE=file_manager:jobs
PIPELINE_QUEUE=ingestion:pipeline:jobs

# Qdrant (shared with web-scrapper — use same collection name)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=qdrant
QDRANT_COLLECTION=scrape_embeddings

# Embeddings via LiteLLM proxy (match web-scrapper)
LITELLM_BASE_URL=http://host.docker.internal:4000
OPENAI_API_KEY=sk-bot
EMBEDDING_MODEL=nvidia-embed-passage
MULTIMODAL_EMBEDDING_MODEL=nvidia-embed-passage
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# Web scrapper API (crawl-scrape pipeline — same compose network)
SCRAPER_API_URL=http://scraper-api:8000

# Frontend (browser must reach API on host)
VITE_API_URL=http://localhost:8007