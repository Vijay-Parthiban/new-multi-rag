# --- Shared Docker network (created by docker compose in this repo) ---
DOCKER_NETWORK=rag-shared

# --- Postgres / Redis (service hostnames on rag-shared) ---
DATABASE_URL=postgresql+psycopg://crawler:crawler@postgres:5432/crawler
REDIS_URL=redis://redis:6379/0

CRAWL_DATA_DIR=./data/crawls
SCRAPE_DATA_DIR=./data/scrapes
RQ_DEFAULT_TIMEOUT=3600

# --- Scrape worker ---
API_BASE_URL=http://api:8000
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=qdrant
QDRANT_COLLECTION=scrape_embeddings

LITELLM_BASE_URL=http://host.docker.internal:4000
OPENAI_API_KEY=sk-bot
EMBEDDING_MODEL=nvidia-embed-passage
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

PLAYWRIGHT_TIMEOUT_MS=30000
SCRAPE_CONCURRENCY=3
SCRAPE_IO_WORKERS=4
SCRAPE_EMBED_WORKERS=4
SCRAPE_MAX_RETRIES=3
