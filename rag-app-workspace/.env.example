# Docker-only setup. All services use rag-shared network hostnames from web-scrapper-workspace.
# Start web-scrapper first: cd ../web-scrapper-workspace && docker compose up -d
DOCKER_NETWORK=rag-shared

# --- Postgres / Redis (shared user `crawler`; RAG database is `rag`, scraper uses `crawler`) ---
DATABASE_URL=postgresql+psycopg://crawler:crawler@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
RQ_DEFAULT_TIMEOUT=3600
RQ_EVAL_QUEUE=eval

# --- Qdrant (shared with web-scrapper) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=qdrant
QDRANT_COLLECTION=scrape_embeddings

# --- LiteLLM proxy on host machine (reachable from containers) ---
LITELLM_BASE_URL=http://host.docker.internal:4000
OPENAI_API_KEY=sk-bot

# --- Retrieval (MUST match web-scrapper EMBEDDING_MODEL / SPARSE_EMBEDDING_MODEL) ---
EMBEDDING_MODEL=nvidia-embed-passage
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
DEFAULT_RETRIEVAL_MODE=hybrid
RETRIEVE_LIMIT=20

# --- Reranker ---
RERANKER_ENABLED=true
# LiteLLM alias (config.yaml model_name) -> nvidia_nim/nvidia/llama-nemotron-rerank-vl-1b-v2
RERANKER_MODEL=nvidia-rerank
RERANK_TOP_K=5

# --- Generation (LiteLLM chat models via Groq) ---
# Available: llama-3.3-70b-versatile, Gpt-oss-120b, llama-3.1-8b-instant, Qwen3-32b
CHAT_MODEL=llama-3.3-70b-versatile
VISION_MODEL=groq-vision
FUSION_MODEL=llama-3.3-70b-versatile
CHAT_MAX_TOKENS=1024
CHAT_TEMPERATURE=0.2

# --- RAGAS evaluation ---
RAGAS_JUDGE_MODEL=llama-3.3-70b-versatile
RAGAS_ENABLED=true
CHAT_METRICS_ASYNC=true

# --- Eval worker ---
EVAL_WORKER_CONCURRENCY=2
EVAL_DEFAULT_K=5

# --- API (8001; web-scrapper api uses 8000) ---
API_HOST=0.0.0.0
API_PORT=8001

# --- OpenTelemetry (apps → collector; exporter backends configured in ../otel/.env) ---
OTEL_TRACING_ENABLED=true
OTEL_SERVICE_NAME=rag-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318
OTEL_CONSOLE_EXPORT=false
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_SERVICE_NAMESPACE=rag-platform
ARIZE_MODEL_ID=rag-platform
ARIZE_PROJECT_NAME=rag-platform

# --- One-time: create RAG database from web-scrapper-workspace (same `crawler` user) ---
# docker compose exec postgres psql -U crawler -d crawler -c "CREATE DATABASE rag;"
