# Chatbot configuration.
#
# This file is the only place a pipeline is named. To use a different pipeline, change the
# endpoint below and restart the backend.
#
# Copy this file to .env and start uvicorn with --env-file .env.

# Which kind of assistant this project is.
#
#   enabled   Every conversation is a session. The page shows Start Session, and the
#             conversation is ended explicitly. Ending it exports the whole conversation as
#             one trace and drops its memory. Traces carry the tag prod-session.
#
#   disabled  Each question is answered on its own. The page shows Start Chat. Traces carry
#             the tag prod-stateless.
#
# This is a declaration, not a switch. The platform still decides from the pipeline's
# Knowledge Product whether memory is actually available, and the page warns when the two
# disagree, so a project is never told it has memory it cannot use.
MEMORY_STATE=enabled

# One entry is one chatbot. Start at 1 and do not skip a number: the list ends at the first
# number with no endpoint.
#
# The endpoint is the assistant root. The backend appends /chat, /chat/stream and
# /sessions/{id} to it, because those routes belong to the same pipeline.
CHATBOT_1_LABEL=TCS Policy Assistant
CHATBOT_1_ENDPOINT=http://localhost:8001/api/assistants/tcs-chat

# A second entry adds a picker to the page. This one reads a Knowledge Product with no Redis
# destination, so it is the stateless case.
CHATBOT_2_LABEL=Resume Assistant
CHATBOT_2_ENDPOINT=http://localhost:8001/api/assistants/no-mem-pipeline

# Generation takes seconds. The stream connection stays open this long.
RAG_API_TIMEOUT_S=300
