# Docker-only setup. All services use rag-shared network hostnames from web-scrapper-workspace.
# Start web-scrapper first: cd ../web-scrapper-workspace && docker compose up -d
DOCKER_NETWORK=rag-shared

# --- Postgres / Redis (shared user `crawler`; RAG database is `rag`, scraper uses `crawler`) ---
DATABASE_URL=postgresql+psycopg://crawler:crawler@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
RQ_DEFAULT_TIMEOUT=3600
RQ_EVAL_QUEUE=eval

# --- Qdrant (shared with web-scrapper) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=qdrant
QDRANT_COLLECTION=scrape_embeddings

# --- Qdrant for knowledge products (a DIFFERENT server from QDRANT_URL) ---
# Every kp_* collection lives here. Leave it empty and a reader falls back to
# QDRANT_URL, finds zero points and answers "no relevant sources".
QDRANT_KP_URL=http://host.docker.internal:6335

# --- Ingestion stack: knowledge products, destinations and pipelines ---
OPENSEARCH_URL=http://host.docker.internal:9200
# Empty username means no auth header is sent.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
INGESTION_SERVICE_URL=http://host.docker.internal:8007
# The kp_* schemas live in the `ingestion` database. Connect as the `ingestion`
# role: `crawler` has no privileges on those schemas.
INGESTION_DATABASE_URL=postgresql://ingestion:ingestion@host.docker.internal:5432/ingestion

# --- Guardrails service ---
GUARDRAILS_URL=http://host.docker.internal:18000
GUARDRAILS_TIMEOUT_S=5.0

# --- LiteLLM proxy on host machine (reachable from containers) ---
LITELLM_BASE_URL=http://host.docker.internal:4000
OPENAI_API_KEY=sk-bot

# --- Retrieval (MUST match web-scrapper EMBEDDING_MODEL / SPARSE_EMBEDDING_MODEL) ---
# nvidia-embed-textonly returns 2048 dimensions, which is the size the fanout
# writes. Do NOT use nvidia-embed-passage: the proxy does not serve it.
EMBEDDING_MODEL=nvidia-embed-textonly
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
DEFAULT_RETRIEVAL_MODE=hybrid
RETRIEVE_LIMIT=20

# --- Reranker ---
RERANKER_ENABLED=true
# LiteLLM alias (config.yaml model_name) -> nvidia_nim/nvidia/llama-nemotron-rerank-vl-1b-v2
RERANKER_MODEL=nvidia-rerank
RERANK_TOP_K=5

# --- Generation (LiteLLM chat models) ---
# Check what the proxy actually serves before you change these:
#   curl -s -H 'Authorization: Bearer sk-bot' http://localhost:4000/v1/models
# Served chat models: Gpt-oss-120b, Gpt-oss-20b, Gpt-Oss-120b-Cloud,
# Gpt-Oss-20b-Cloud, Kimi-K2.5-Cloud, GLM-5.1-Cloud, GLM-5.1-NVIDIA,
# Minimax-M2.7-NVIDIA, groq-vision, nemotron-vision-NVIDIA, nvidia-rerank,
# All-MiniLM-L6-v2, All-mpnet-base-v2
CHAT_MODEL=Gpt-oss-20b
# The vision model for image chunks. Must be a served multimodal model.
VISION_MODEL=groq-vision
FUSION_MODEL=Gpt-oss-20b
CHAT_MAX_TOKENS=1024
CHAT_TEMPERATURE=0.2

# --- RAGAS evaluation ---
RAGAS_JUDGE_MODEL=Gpt-oss-120b
RAGAS_ENABLED=true
CHAT_METRICS_ASYNC=true

# The LLM query router and self-corrective RAG are NOT implemented.
# `rag_core.query_router` was never written, so the Chat page no longer offers
# the Router, Classifier, RAG Mode or Max Loops controls, and these settings are
# not read: SC_MODEL, ROUTER_MODE, ROUTER_MODEL, ROUTER_ENABLED.

# --- Eval worker ---
EVAL_WORKER_CONCURRENCY=2
EVAL_DEFAULT_K=5
# On Windows add --worker-class rq.worker.SimpleWorker: the default worker calls
# os.fork(), which Windows does not have, and dies when a metrics job arrives.
#   uv run rq worker eval --url redis://localhost:6379/0 --worker-class rq.worker.SimpleWorker

# --- API (8001; web-scrapper api uses 8000) ---
API_HOST=0.0.0.0
API_PORT=8001

# --- OpenTelemetry (apps → collector; exporter backends configured in ../otel/.env) ---
OTEL_TRACING_ENABLED=true
OTEL_SERVICE_NAME=rag-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318
OTEL_CONSOLE_EXPORT=false
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_SERVICE_NAMESPACE=rag-platform
ARIZE_MODEL_ID=rag-platform
ARIZE_PROJECT_NAME=rag-platform

# --- One-time: create RAG database from web-scrapper-workspace (same `crawler` user) ---
# docker compose exec postgres psql -U crawler -d crawler -c "CREATE DATABASE rag;"
