# Copy to otel/.env and fill in. Used by the otel-collector service, which substitutes these
# values into otel-collector-config.yaml.
#
# Two exporters are active: Phoenix and Langfuse. Everything below them is a disabled example.

# --- Collector telemetry ---
OTEL_LOG_LEVEL=info
# "basic" logs a line per batch. "detailed" logs every span and every attribute.
OTEL_DEBUG_VERBOSITY=basic
# Stamped on every span as deployment.environment. This is the collector-wide default; the
# application overrides it per request with the trace mode (test or prod).
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_SERVICE_NAMESPACE=rag-platform

# --- Langfuse (OTLP/HTTP) ---
# Regions:
#   EU:    https://cloud.langfuse.com/api/public/otel
#   US:    https://us.cloud.langfuse.com/api/public/otel
#   JP:    https://jp.cloud.langfuse.com/api/public/otel
#   HIPAA: https://hipaa.cloud.langfuse.com/api/public/otel
LANGFUSE_OTLP_ENDPOINT=https://jp.cloud.langfuse.com/api/public/otel
# HTTP Basic over base64("public_key:secret_key"):
#   printf '%s' "pk-lf-...:sk-lf-..." | base64 -w0   →   prefix the result with "Basic "
LANGFUSE_AUTH_HEADER=Basic <base64(pk-lf-...:sk-lf-...)>

# --- Phoenix (OTLP/HTTP) ---
# Phoenix Cloud. A self-hosted Phoenix needs no auth header and listens on
# http://localhost:6006/v1/traces.
PHOENIX_OTLP_ENDPOINT=https://app.phoenix.arize.com/v1/traces
# Phoenix expects Authorization: Bearer <api key>.
PHOENIX_AUTH_HEADER=Bearer <phoenix-api-key>
# The Phoenix project every span is routed to, sent as x-project-name.
PHOENIX_PROJECT_NAME=rag-platform

# --- Arize AX (extension example, disabled in the config) ---
# A different product from Phoenix: gRPC, authenticated with api_key and space_id.
ARIZE_OTLP_ENDPOINT=otlp.arize.com:443
ARIZE_API_KEY=
ARIZE_SPACE_ID=
# Arize AX requires model_id or arize.project.name on every span resource.
ARIZE_MODEL_ID=rag-platform
ARIZE_PROJECT_NAME=rag-platform

# --- Grafana Cloud (extension example, disabled in the config) ---
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
GRAFANA_AUTH_HEADER=Basic <instanceId:token base64>
