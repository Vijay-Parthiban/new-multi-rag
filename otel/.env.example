# Copy to otel/.env and fill in credentials.
# Used by the otel-collector service (env substitution in otel-collector-config.yaml).

# --- Collector telemetry ---
OTEL_LOG_LEVEL=info
OTEL_DEBUG_VERBOSITY=basic
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_SERVICE_NAMESPACE=rag-platform

# --- Langfuse (OTLP/HTTP) ---
# Regions:
#   EU:    https://cloud.langfuse.com/api/public/otel
#   US:    https://us.cloud.langfuse.com/api/public/otel
#   JP:    https://jp.cloud.langfuse.com/api/public/otel
#   HIPAA: https://hipaa.cloud.langfuse.com/api/public/otel
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# echo -n "pk-lf-...:sk-lf-..." | base64  →  then prefix with "Basic "
LANGFUSE_AUTH_HEADER=Basic <base64(pk-lf-...:sk-lf-...)>

# --- Arize AX (OTLP gRPC) ---
ARIZE_OTLP_ENDPOINT=otlp.arize.com:443
ARIZE_API_KEY=
ARIZE_SPACE_ID=
# Required on every span resource (also injected by the collector resource processor)
ARIZE_MODEL_ID=rag-platform
ARIZE_PROJECT_NAME=rag-platform

# --- Grafana Cloud (OTLP/HTTP) ---
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
GRAFANA_AUTH_HEADER=Basic <instanceId:token base64>
