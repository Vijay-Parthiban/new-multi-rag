# The compose Postgres. This pointed at sqlite+aiosqlite:///storage/ingestion.db, which
# is what filled that file with a stale copy of the data: a host run read SQLite while
# every container read Postgres, and the two answered differently for the same request.
DATABASE_URL=postgresql://ingestion:ingestion@localhost:5432/ingestion
STORAGE_PATH=storage
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# Knowledge-product collections. One Qdrant serves the scraper and the products, so this
# names the same server as QDRANT_URL. It stayed on 6335 after the two servers were merged
# into one and pointed at a port nothing listens on.
QDRANT_KP_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000
OPENSEARCH_URL=http://localhost:9200
