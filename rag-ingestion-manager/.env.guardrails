# Runtime settings for the guardrails service.
HF_TOKEN=hf_dummy_token

# The three LLM-backed validators (local/toxic_language, local/restrict_to_topic,
# local/prompt_injection) call the LiteLLM proxy that the rest of the platform uses.
# Reaching the host from inside the container needs the extra_hosts entry in docker-compose.
LITELLM_BASE_URL=http://host.docker.internal:4000
LLM_API_KEY=sk-bot
GUARDRAIL_LLM_MODEL=Gpt-oss-20b
# Reasoning models spend the first tokens on reasoning and return an empty body
# when the budget is too small. 512 is measured to be enough.
GUARDRAIL_LLM_MAX_TOKENS=512
